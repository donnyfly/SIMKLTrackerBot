DISCORD_BOT_TOKEN=your_discord_bot_token_here
SIMKL_CLIENT_ID=your_simkl_client_id_here
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE
# Default IANA timezone used for watch statistics and streaks.
# Server administrators can override this with /simkl-timezone.
SIMKL_DEFAULT_TIMEZONE=Asia/Singapore

# How often the bot checks SIMKL for new activity.
# Recommended: 60 minutes.
POLL_INTERVAL_MINUTES=60

# Maximum number of different SIMKL users processed at the same time.
# Increase only if your API limits and server resources allow it.
POLL_CONCURRENCY=5
MDBLIST_API_KEY=your_mdblist_api_key_here
# Optional path for the generated IMDb episode ratings database.
# Defaults to data/imdb_ratings.db
# IMDB_RATINGS_DB_PATH=data/imdb_ratings.db
